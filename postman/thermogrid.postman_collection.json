{
  "info": {
    "name": "ThermoGrid gateway tests",
    "description": "Phase 10. Run the folders in order with the Collection Runner. Set gateway, viewerPassword, operatorPassword and adminPassword in your local environment. No secret is stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "viewerPassword",
      "value": ""
    },
    {
      "key": "operatorPassword",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "workloadId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Authentication",
      "item": [
        {
          "name": "Login viewer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"viewerToken\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"viewer\",\"password\":\"{{viewerPassword}}\"}"
            }
          }
        },
        {
          "name": "Login operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
