            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.jwt"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/topology"
          }
        },
        {
          "name": "Me (viewer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"role VIEWER\", function () { pm.expect(pm.response.json().role).to.eql(\"VIEWER\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{viewerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gateway}}/api/auth/me"
          }
        }
      ]
