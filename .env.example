# ThermoGrid environment template. Copy to .env and replace every placeholder.
# Placeholders only: never commit real values. .env is git-ignored.

# --- Secrets (plan section 3) ---
# JWT signing secret shared by auth-service (signs) and api-gateway (verifies). At least 32 characters; both
# services refuse to start without it. Generate one:  openssl rand -base64 48   or   python -c "import secrets; print(secrets.token_urlsafe(48))"
THERMOGRID_JWT_SECRET=CHANGE_ME_long_random_string_at_least_32_chars
# Shared token for service-to-service calls to /internal/**. Every servlet service refuses to start without it.
THERMOGRID_INTERNAL_TOKEN=CHANGE_ME_random_internal_token
# Security switch (default true = secured setup). Only set false for a deliberate local experiment; it turns off the
# gateway JWT check and the /internal token check. Tests switch it off in their own test profiles.
THERMOGRID_SECURITY_ENABLED=true

# --- Connection defaults (plan section 13.3) ---
EUREKA_URL=http://localhost:8761/eureka
RABBITMQ_HOST=localhost
DB_URL=jdbc:mysql://localhost:3306/CHANGE_ME_schema
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Infrastructure (infra/docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# --- Per-service MySQL passwords (user = service name, schema = <service>_db) ---
AUTH_DB_PASSWORD=CHANGE_ME
TOPOLOGY_DB_PASSWORD=CHANGE_ME
TELEMETRY_DB_PASSWORD=CHANGE_ME
WORKLOAD_DB_PASSWORD=CHANGE_ME
SCHEDULER_DB_PASSWORD=CHANGE_ME
COOLING_DB_PASSWORD=CHANGE_ME

# --- Seeded demo users (auth-service). Usernames default to viewer, operator and admin. ---
# Set a password per user; it is hashed with BCrypt when auth-service starts and the plain value is never stored.
# A user with no password is skipped. Changing a password here and restarting auth-service updates the stored hash.
# Alternative: set SEED_<ROLE>_PASSWORD_HASH to a ready-made BCrypt hash ($2a$..., the hash wins over the password).
#   SEED_VIEWER_USERNAME=viewer   SEED_OPERATOR_USERNAME=operator   SEED_ADMIN_USERNAME=admin
SEED_VIEWER_PASSWORD=CHANGE_ME
SEED_OPERATOR_PASSWORD=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Ports (optional) ---
# api-gateway listens on this port (default 8080). Set it when 8080 is taken, for example 18080.
GATEWAY_PORT=8080
# --- Docker deployment options (infra/docker-compose.full.yml; the README explains them) ---
# Public port of nginx: the dashboard is http://localhost:HTTP_PORT/ . Use 8088 if port 80 is already taken on your computer.
HTTP_PORT=80
# Competing telemetry consumers, 1 to 3 (plan section 5.8).
TELEMETRY_REPLICAS=3
# Host ports for the RabbitMQ management UI and the Eureka dashboard (both bound to 127.0.0.1 only).
RABBITMQ_UI_PORT=15673
EUREKA_PORT=8762
