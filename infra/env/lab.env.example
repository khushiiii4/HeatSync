# Environment for the full deployment (infra/docker-compose.full.yml) on one computer (the final demonstration). Placeholders only. The repository-root .env.example is the same list; use either.
# Copy to infra/env/lab.env (git-ignored) or to the repository .env, replace every CHANGE_ME, then:
#   docker compose --env-file infra/env/lab.env -f infra/docker-compose.full.yml up -d --build
# Generate each secret with:  openssl rand -base64 48   (keep passwords to letters and digits for MySQL and RabbitMQ).

# --- Secrets (never commit real values) ---
THERMOGRID_JWT_SECRET=CHANGE_ME_at_least_32_random_characters
THERMOGRID_INTERNAL_TOKEN=CHANGE_ME_random_internal_token
THERMOGRID_SECURITY_ENABLED=true

# --- Infrastructure passwords ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
TOPOLOGY_DB_PASSWORD=CHANGE_ME
TELEMETRY_DB_PASSWORD=CHANGE_ME
WORKLOAD_DB_PASSWORD=CHANGE_ME
SCHEDULER_DB_PASSWORD=CHANGE_ME
COOLING_DB_PASSWORD=CHANGE_ME

# --- Demo users (auth-service hashes these with BCrypt at startup) ---
SEED_VIEWER_PASSWORD=CHANGE_ME
SEED_OPERATOR_PASSWORD=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Deployment options ---
HTTP_PORT=80                 # public port of nginx (the dashboard is http://localhost:HTTP_PORT/)
TELEMETRY_REPLICAS=3         # competing telemetry consumers, 1 to 3 (plan section 5.8)
RABBITMQ_UI_PORT=15673       # RabbitMQ management UI, bound to 127.0.0.1 on your computer
EUREKA_PORT=8762             # Eureka dashboard, bound to 127.0.0.1 on your computer
