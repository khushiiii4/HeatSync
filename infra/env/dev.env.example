# Development settings (services run from Maven or the IDE, MySQL and RabbitMQ from infra/docker-compose.yml).
# The repository-root .env.example is the full template; this file only lists the connection defaults the services
# already use when nothing is set, so a developer can see them in one place. Placeholders only.
EUREKA_URL=http://localhost:8761/eureka/
RABBITMQ_HOST=localhost
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
# Per-service MySQL users are <service>@localhost:3306/<service>_db; passwords come from <SERVICE>_DB_PASSWORD.
GATEWAY_PORT=8080
THERMOGRID_SECURITY_ENABLED=true
